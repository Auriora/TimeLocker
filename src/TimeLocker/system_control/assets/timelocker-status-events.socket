[Unit]
Description=TimeLocker protected local status-event socket

[Socket]
ListenStream=/run/timelocker/status-events.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=timelocker-operators
SocketMode=0660
FileDescriptorName=status-events
RemoveOnStop=yes
Service=timelocker-control.service

[Install]
WantedBy=sockets.target
