[Unit]
Description=TimeLocker local system-control socket

[Socket]
ListenStream=/run/timelocker/control.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=timelocker-operators
SocketMode=0660
FileDescriptorName=control
RemoveOnStop=yes
Service=timelocker-control.service

[Install]
WantedBy=sockets.target
