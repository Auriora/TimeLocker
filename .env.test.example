# TimeLocker Test Environment Configuration
# Copy this file to .env.test and customize as needed

# MinIO Configuration (proxied behind Traefik at minio.lan)
MINIO_ENDPOINT=minio.lan
MINIO_ENDPOINT_URL=https://minio.lan
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=timelocker-test
MINIO_REGION=us-east-1
MINIO_VERIFY_SSL=false

# AWS S3 Configuration (for MinIO compatibility)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT=https://minio.lan

# TimeLocker Configuration
TIMELOCKER_CONFIG_FILE=./test-config.json
TIMELOCKER_PASSWORD=test-password-123

# Test Settings
TIMELOCKER_LOG_LEVEL=DEBUG
TIMELOCKER_TEST_MODE=true
RESTIC_INSECURE_TLS=true
