[Unit]
Description=TimeLocker Backup - test-schedule
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/vscode/.local/bin/timelocker backup create --policy test-policy --non-interactive
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timelocker-test-schedule

[Install]
WantedBy=multi-user.target
